{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // iCloud Drive syncs this repo (it lives under ~/Documents) and resolves
    // concurrent writes by dropping conflict copies next to the original:
    // "routes.d 2.ts", "cache-life.d 3.ts", … Those land inside the
    // ".next/types/**" include above and break the build with bogus
    // TS2300/TS2428 "duplicate identifier" errors pointing at generated files
    // nobody wrote. Never compile them.
    "**/* [0-9].ts",
    "**/* [0-9].tsx",
    "**/* [0-9].mts",
    "**/* [0-9].d.ts"
  ]
}
